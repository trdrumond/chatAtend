@font-face {
  font-family: neosans;
  src: url('NeoSans.otf');
}
body {
      background-color: #EEEEEE;
      font-family: 'neosans', 'Open Sans', sans-serif;
      font-size: 10px;
}

h1 {
    font-size: 44px !important;
}

ident {
    font-size: 8px !important;
}


  #header {
    margin-top: 5px;
    margin-left: 5px;
    background: #FFFFFF;
    width: 99%;
    min-height: 161px;
    border-radius: 10px;

  }

  #suspended {
    margin-top: 10px;
    margin-left: 10px;
    padding-left: 10px;
    padding-right: 30px;
    width: 99%;
    height: 20px;
    text-align: right;
    float: left;
    font-size: 26px;
  }


  #page {
    margin-top: 5px;
    margin-left: 1%;
    padding-top: 0px;
    text-align: left ;
    width: 88%;
    min-width: 50%;
    height: 500px;
    float: left;
    font-size: 10px;
    color: #000000;
  }

  .btn-solvetask {
    background: #252159 !important;
    border: #252159 !important;
  }

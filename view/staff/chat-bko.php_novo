<?php

    // Consulta otimizada para dados do usuário
    $sql = "SELECT a.id_user, a.nome_usuario, a.nome, a.sobrenome,
            CONCAT(a.nome, ' ', a.sobrenome) as nome_completo,
            a.email, a.agencia_id, d.nome_agencia, a.empresa_id,
            e.nome_empresa, b.img
            FROM tbl_user a
            INNER JOIN tbl_user_img_perfil b ON a.id_user = b.user_id
            INNER JOIN tbl_agencia d ON a.agencia_id = d.id_agencia
            LEFT JOIN tbl_empresa e ON a.empresa_id = e.id_empresa
            WHERE a.id_user = ?";

    $stmt = $PDO->prepare($sql);
    $stmt->execute([$infFila['ate_resp']]);
    $dados_ate = $stmt->fetch(PDO::FETCH_ASSOC);

    $userDestinatario = $infFila['ate_resp'];

    // Busca informações do chat em uma única consulta
    $sql = "SELECT id_chat, token_chat, status_chat, fila_chat_id
            FROM tbl_chat_info
            WHERE (status_chat = 1
            AND contrato_id = ?
            AND rem_chat = ?
            AND dest_chat = ?)
            OR fila_chat_id = ?
            LIMIT 1";

    $stmt = $PDO->prepare($sql);
    $stmt->execute([
        $infoUser['contrato_id'],
        $infoUser['id_user'],
        $userDestinatario,
        $infFila['id_fila_chat']
    ]);
    $infoChat = $stmt->fetch(PDO::FETCH_ASSOC);

    // Se não existe chat, cria um novo
    if (!$infoChat) {
        $tokenChat = md5($userDestinatario . date('YmdHis'));

        if ($infoUser['nivel_id'] == 4) {
            $sql = "INSERT INTO tbl_chat_info (
                contrato_id, token_chat, assunto_id, fila_id,
                rem_chat, dest_chat, status_chat, fila_chat_id, indice
            ) VALUES (?, ?, ?, ?, ?, ?, 1, ?, ?)";

            $stmt = $PDO->prepare($sql);
            $stmt->execute([
                $infFila['contrato_id'],
                $tokenChat,
                $infFila['assunto_id'],
                $infFila['fila_id'],
                $infoUser['id_user'],
                $userDestinatario,
                $infFila['id_fila_chat'],
                $indDiv
            ]);

            // Busca o ID do chat recém-criado
            $sql = "SELECT id_chat, token_chat, status_chat, fila_chat_id
                    FROM tbl_chat_info
                    WHERE token_chat = ?";
            $stmt = $PDO->prepare($sql);
            $stmt->execute([$tokenChat]);
            $infoChat = $stmt->fetch(PDO::FETCH_ASSOC);
        }
    }

    // Atualiza informações do atendimento
    $sql = "SELECT id FROM tbl_tma_atend
            WHERE fila_chat_id IS NULL AND resp_id = ?";
    $stmt = $PDO->prepare($sql);
    $stmt->execute([$infoUser['id_user']]);
    $infoAtend = $stmt->fetch(PDO::FETCH_ASSOC);

    if (!empty($infoAtend['id'])) {
        $sql = "UPDATE tbl_tma_atend
                SET fila_chat_id = ?,
                    chat_id = ?,
                    fila_id = ?,
                    date_in = NOW()
                WHERE id = ?";
        $stmt = $PDO->prepare($sql);
        $stmt->execute([
            $infFila['id_fila_chat'],
            $infoChat['id_chat'],
            $infFila['fila_id'],
            $infoAtend['id']
        ]);
    }

    // Busca FAQs relacionadas
    $sql = "SELECT id_faq, titulo_faq, txt
            FROM tbl_faq
            WHERE fila_id = ?
            AND (assunto_id = 0 OR assunto_id = ?)";
    $stmt = $PDO->prepare($sql);
    $stmt->execute([$infFila['fila_id'], $infFila['assunto_id']]);
    $infoFaq = $stmt->fetchAll(PDO::FETCH_ASSOC);

    $chatId = $infoChat['id_chat'];
?>


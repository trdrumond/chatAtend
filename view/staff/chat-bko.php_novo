function loadTa_<?=$infoChat['id_chat'];?>(tempo) {
    var div = '#div_ta_<?=$infoChat['id_chat'];?>';
    $.post("staff/load_ta.php", {
            tempo
        },
        function(valor) {
            $(div).html(valor);
        });
}

function loadFilaAtiva(fila) {
    var div = '.fila_ativa';
    $.post("staff/load_fila_ativa.php", {
            fila
        },
        function(valor) {
            $(div).html(valor);
        });
}
</script>

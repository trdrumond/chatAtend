<?php
include("../cnf/session.php");

$indDiv=$_POST['indice'];

if (!empty($_POST['protocolo'])) {
    $sql = "SELECT id_fila_chat, protocolo, status_fila, ate_resp, bko_resp,
            hora_inicio, fila_id, assunto_id, contrato_id,
            TIMEDIFF(NOW(), data_hora) as te_diff,
            COALESCE(te, TIMEDIFF(NOW(), data_hora)) as te,
            hora_inicio
            FROM tbl_chat_fila
            WHERE status_fila = 2 AND protocolo = ?";
    $st = $PDO->prepare($sql);
    $st->execute([$_POST['protocolo']]);
    $infFila = $st->fetch(PDO::FETCH_ASSOC);

    if (!$infFila) {
        $baseQuery = "SELECT id_fila_chat, protocolo, status_fila, ate_resp,
                    bko_resp, hora_inicio, fila_id, assunto_id, contrato_id,
                    TIMEDIFF(NOW(), data_hora) as te_diff,
                    COALESCE(te, TIMEDIFF(NOW(), data_hora)) as te
                    FROM tbl_chat_fila
                    WHERE status_fila = 1 AND bko_resp IS NULL";

        // Primeira tentativa com fila_id do usuário
        $sql = $baseQuery . " AND fila_id = ? ORDER BY id_fila_chat ASC LIMIT 1";
        $stmt = $PDO->prepare($sql);
        $stmt->execute([$infoUser['fila_id']]);
        $infFila = $stmt->fetch(PDO::FETCH_ASSOC);

        // Se não encontrou, tenta com as filas do usuário
        if (!$infFila) {
            $stmt = $PDO->prepare("SELECT filas FROM tbl_user_filas WHERE user_id = ?");
            $stmt->execute([$_SESSION['dados']['id_user']]);
            $cnfFilas = $stmt->fetch(PDO::FETCH_ASSOC);

            if (!empty($cnfFilas['filas'])) {
                $sql = $baseQuery . " AND fila_id IN (" . $cnfFilas['filas'] . ")
                        ORDER BY id_fila_chat ASC LIMIT 1";
                $stmt = $PDO->prepare($sql);
                $stmt->execute();
                $infFila = $stmt->fetch(PDO::FETCH_ASSOC);
            }
        }
    }
}

if($infFila['id_fila_chat']==''){
    echo "<script>console.log('Vazio');</script>";
    //echo "<script>setTimeout(function(){ actionPage('dash-ate', 'idx'); }, 500);</script>";
} else {
    if($infFila['bko_resp']==''){

        $sql="UPDATE tbl_chat_fila SET status_fila=2, bko_resp=".$infoUser['id_user'].", hora_inicio=now(), te='".$infFila['te']."' where id_fila_chat=".$infFila['id_fila_chat'];
        //echo "<br>".$sql;
        $stmt = $PDO->prepare( $sql );
        $result = $stmt->execute();
        logAtendimento($PDO, $_SESSION['dados']['id_user'], 'Tratamento');

    }

}

$infFila['hora_inicio'] = ($infFila['hora_inicio']!='') ? $infFila['hora_inicio'] : date('Y-m-d H:i:s');

?>




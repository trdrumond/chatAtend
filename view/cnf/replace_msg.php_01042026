<?php
include_once("conn.php");

set_time_limit(0);

function getDivMsg($count){
    if ($count <= 0) {
        return 0;
    }

    return (int) ceil($count / 10000);
}

function logReplaceMsg($level, $message){
    echo "[".date('Y-m-d H:i:s')."] ".$level.": ".htmlspecialchars($message, ENT_QUOTES, 'UTF-8')."<br>";
    @ob_flush();
    flush();
}

$lotesSucesso = 0;
$lotesErro = 0;
$registrosProcessados = 0;
$totalRegistros = 0;
$limite = 10000;

echo '<div style="background:#111;color:#d7ffd9;font-family:monospace;font-size:13px;line-height:1.5;padding:12px;border-radius:6px;white-space:pre-wrap;">';

logReplaceMsg("INFO", "Iniciando rotina de sincronizacao de tbl_chat_msg para tbl_chat_msg_secondary.");

$stmtCount = $PDO->prepare("SELECT COUNT(*) AS total FROM tbl_chat_msg");

if (! $stmtCount->execute()) {
    $errorInfo = $stmtCount->errorInfo();
    logReplaceMsg("ERROR", "Falha ao contar registros de tbl_chat_msg: ".$errorInfo[2]);
    echo '</div>';
    return;
}

$countResult = $stmtCount->fetch(PDO::FETCH_ASSOC);
$totalRegistros = (int) $countResult['total'];
$param = getDivMsg($totalRegistros);

logReplaceMsg("INFO", "Total de registros encontrados: ".$totalRegistros.".");

if ($param === 0) {
    logReplaceMsg("INFO", "Nenhum registro encontrado para sincronizacao.");
    echo '</div>';
    return;
}

for ($i = 0; $i < $param; $i++) {
    $offset = $i * $limite;
    $stmt = $PDO->prepare("SELECT id_msg, data_hora, chat_id, contrato_id, rem_id, dest_id, msg, flag FROM tbl_chat_msg ORDER BY id_msg ASC LIMIT ".$offset.", ".$limite);

    if (! $stmt->execute()) {
        $lotesErro++;
        $errorInfo = $stmt->errorInfo();
        logReplaceMsg("ERROR", "Falha ao carregar lote ".($i + 1)."/".$param.": ".$errorInfo[2]);
        continue;
    }

    $info1 = $stmt->fetchAll(PDO::FETCH_ASSOC);
    $values = array();

    foreach ($info1 as $ls) {
        $ls['id_msg'] = ($ls['id_msg'] == '') ? 'NULL' : "'".nomeCampo($ls['id_msg'])."'";
        $ls['data_hora'] = ($ls['data_hora'] == '') ? 'NULL' : "'".nomeCampo($ls['data_hora'])."'";
        $ls['chat_id'] = ($ls['chat_id'] == '') ? 'NULL' : "'".nomeCampo($ls['chat_id'])."'";
        $ls['contrato_id'] = ($ls['contrato_id'] == '') ? 'NULL' : "'".nomeCampo($ls['contrato_id'])."'";
        $ls['rem_id'] = ($ls['rem_id'] == '') ? 'NULL' : "'".nomeCampo($ls['rem_id'])."'";
        $ls['dest_id'] = ($ls['dest_id'] == '') ? 'NULL' : "'".nomeCampo($ls['dest_id'])."'";
        $ls['msg'] = ($ls['msg'] == '') ? 'NULL' : "'".nomeCampo($ls['msg'])."'";
        $ls['flag'] = ($ls['flag'] == '') ? 'NULL' : "'".nomeCampo($ls['flag'])."'";

        $values[] = "(".$ls['id_msg'].",".$ls['data_hora'].",".$ls['chat_id'].",".$ls['contrato_id'].",".$ls['rem_id'].",".$ls['dest_id'].",".$ls['msg'].",".$ls['flag'].")";
    }

    if (count($values) === 0) {
        logReplaceMsg("INFO", "Lote ".($i + 1)."/".$param." sem registros para processamento.");
        continue;
    }

    $sqlNew5 = "REPLACE INTO tbl_chat_msg_secondary (id_msg, data_hora, chat_id, contrato_id, rem_id, dest_id, msg, flag) VALUES ".implode(',', $values);
    $stmt6 = $PDO->prepare($sqlNew5);
    $result6 = $stmt6->execute();

    if ($result6) {
        $lotesSucesso++;
        $registrosProcessados += count($values);
        logReplaceMsg("INFO", "Lote ".($i + 1)."/".$param." processado com sucesso. Registros no lote: ".count($values).".");
    } else {
        $lotesErro++;
        $errorInfo = $stmt6->errorInfo();
        logReplaceMsg("ERROR", "Falha no lote ".($i + 1)."/".$param.": ".$errorInfo[2]);
    }
}

logReplaceMsg(
    "INFO",
    "Rotina finalizada. Registros lidos: ".$totalRegistros.". Registros processados: ".$registrosProcessados.". Lotes com sucesso: ".$lotesSucesso.". Lotes com erro: ".$lotesErro."."
);
echo '</div>';
?>
function dadosIdx(resp_id, fila_id, contrato_id){
    var resp_id;
    var fila_id;
    var contrato_id;


    $.post("staff/load_dados_dash_ind.php",
        {
            resp_id, fila_id, contrato_id
        },
        function (valor) {
            $("#dadosDashInd").html(valor);
            //console.log(valor);
        }
    );
    $.post("staff/load_star.php",
        {
            resp_id, fila_id, contrato_id
        },
        function (valor) {
            $("#star").html(valor);
        }
    );



}





<script>
    var usuariosOffset = 0;
    var usuariosLimit = <?= $limitInicial; ?>;
    var usuariosLoading = false;
    var usuariosHasMore = true;
    var usuariosBusca = '';
    var usuariosTotal = 0;
    var usuariosScrollHandlerAttached = false; // não será mais usado (scroll infinito desativado)
    var usuariosAutoLoadTimer = null;

    function renderUsuarios(rows) {
        if (!rows || !rows.length) return;
        var $tbody = $("#tbody-usuarios");
        rows.forEach(function(u) {
            var ativoIcon = u.ativo == 1 ?
                '<i class="fas fa-check" style="color: green"></i>' :
                '<i class="fas fa-times" style="color: red"></i>';
            // Coluna textual de situação será escondida (mantemos só o ícone)
            var ativoString = '';

            // Quando não houver fila, deixa a célula em branco (inclusive quando vier como string "null")
            var nomeFila = '';
            if (u.nome_fila) {
                var filaStr = String(u.nome_fila).trim().toLowerCase();
                if (filaStr !== 'null' && filaStr !== 'undefined') {
                    nomeFila = u.nome_fila;
                }
            }

            var filasIcon = '';
            if (u.nivel_id == 4) {
                filasIcon = '<i class="fas fa-list fa-2x pointer" title="Filas" data-bs-toggle="modal" data-bs-target="#modal_filas" onclick="loadFilas(' + u.id_user + ')"></i>';
            }

            var mailIcon = '';
            if (u.permite_mail == 1) {
                if (u.flag_mail == 0) {
                    mailIcon = '<i id="mail_' + u.id_user + '" class="far fa-envelope fa-2x pointer" title="E-mail de cadastro não enviado" data-bs-toggle="modal" data-bs-target="#modal_mail" onclick="loadMail(' + u.id_user + ')"></i>';
                } else {
                    mailIcon = '<i id="mail_' + u.id_user + '" class="fas fa-paper-plane fa-2x pointer" title="Reenviar e-mail de cadastro" data-bs-toggle="modal" data-bs-target="#modal_mail" onclick="loadMail(' + u.id_user + ')"></i>';
                }
            }

            var editIcon;
            if (u.cad_cnf == 1) {
                editIcon = '<i class="fas fa-edit fa-2x pointer" title="Detalhes/Alteração de Usuário" data-bs-toggle="modal" data-bs-target="#modal_alt" onclick="loadAlt(' + u.id_user + ')"></i>';
            } else {
                editIcon = '<i class="fas fa-info-circle fa-2x pointer" title="Detalhes/Alteração de Usuário" data-bs-toggle="modal" data-bs-target="#modal_alt" onclick="loadAlt(' + u.id_user + ')"></i>';
            }

            var resetIcon = '<i class="fas fa-key fa-2x pointer" title="Resetar senha de usuário" id="reset_' + u.id_user + '" onclick="resetPass(' + u.id_user + ', \'' + u.nome_usuario.replace(/'/g, "\\'") + '\')"></i>';

            // Trata data de inativação: qualquer valor "nulo" fica em branco
            var dataInat = '';
            if (u.data_inativo) {
                var di = String(u.data_inativo).trim().toLowerCase();
                if (di !== 'null' && di !== 'undefined' && di !== '0000-00-00' && di !== '00/00/0000') {
                    dataInat = u.data_inativo;
                }
            }

            var tr = '<tr>' +
                '<td>' + u.nome_completo + '</td>' +
                '<td align="center">' + u.nome_usuario + '</td>' +
                '<td align="center">' + u.email + '</td>' +
                '<td align="center">' + u.nome_agencia + '</td>' +
                '<td align="center">' + u.uf + '</td>' +
                '<td align="center">' + u.nome_empresa + '</td>' +
                '<td align="center">' + u.nome_nivel + '</td>' +
                '<td align="center">' + nomeFila + '</td>' +
                '<td align="center">' + u.data_cad + '</td>' +
                '<td align="center">' + dataInat + '</td>' +
                '<td align="center">' + ativoIcon + '</td>' +
                '<td align="center" style="display:none;">' + ativoString + '</td>' +
                '<td align="center">' + filasIcon + '</td>' +
                '<td align="center">' + mailIcon + '</td>' +
                '<td align="center">' + editIcon + '</td>' +
                '<td align="center">' + resetIcon + '</td>' +
                '</tr>';
            $tbody.append(tr);
        });
    }

    function atualizarInfoUsuarios() {
        var texto = 'Carregados ' + usuariosOffset + ' de ' + (usuariosTotal || '?') + ' usuários';
        if (!usuariosHasMore) {
            texto = 'Total de ' + usuariosTotal + ' usuários carregados';
        }
        $("#infoUsuarios").text(texto);
    }

    function loadUsuarios(reset) {
        if (usuariosLoading) return;
        usuariosLoading = true;

        // Cancela qualquer agendamento anterior de auto-load
        if (usuariosAutoLoadTimer) {
            clearTimeout(usuariosAutoLoadTimer);
            usuariosAutoLoadTimer = null;
        }

        if (reset) {
            usuariosOffset = 0;
            usuariosHasMore = true;
            $("#tbody-usuarios").empty();
        }

        $("#infoUsuarios").text('Carregando usuários...');

        $.post("staff/load_usuarios.php", {
            offset: usuariosOffset,
            limit: usuariosLimit,
            busca: usuariosBusca
        }, function(resp) {
            usuariosLoading = false;
            try {
                var data = typeof resp === "string" ? JSON.parse(resp) : resp;
                if (Array.isArray(data.rows)) {
                    renderUsuarios(data.rows);
                    usuariosOffset += data.rows.length;
                    usuariosTotal = data.total || usuariosTotal;
                    usuariosHasMore = data.hasMore === true;
                    atualizarInfoUsuarios();

                    // Se ainda houver mais usuários, agenda próxima carga automática em 0.5 segundo
                    if (usuariosHasMore) {
                        usuariosAutoLoadTimer = setTimeout(function() {
                            loadUsuarios(false);
                        }, 500);
                    }
                } else {
                    $("#infoUsuarios").text('Não foi possível carregar os usuários.');
                }
            } catch (e) {
                console.error("Erro ao processar retorno de load_usuarios.php", e, resp);
                $("#infoUsuarios").text('Erro ao carregar os usuários.');
            }
        }).fail(function() {
            usuariosLoading = false;
            $("#infoUsuarios").text('Erro ao carregar os usuários.');
        });
    }

    $(document).ready(function() {
        // Carga inicial
        loadUsuarios(true);

        // Busca em todos os campos (na base completa, via backend)
        var buscaTimeout = null;
        $("#buscaUsuarios").on("keyup", function() {
            var val = $(this).val();
            usuariosBusca = val;
            if (buscaTimeout) clearTimeout(buscaTimeout);
            buscaTimeout = setTimeout(function() {
                loadUsuarios(true);
            }, 500);
        });

        // Exportação Excel da base completa (considerando o filtro atual, se houver)
        $("#btnExportUsuarios").on("click", function() {
            var q = encodeURIComponent(usuariosBusca || '');
            window.open("staff/export_usuarios_excel.php?busca=" + q, "_blank");
        });
    });
</script>

